# Copy this file to ".env" and fill in your real key.
# All notebook sessions read ANTHROPIC_API_KEY via os.environ or python-dotenv.
#
# How to use locally on Windows PowerShell (one shot for current shell):
#   $env:ANTHROPIC_API_KEY = "sk-ant-..."
# Persist across sessions:
#   setx ANTHROPIC_API_KEY "sk-ant-..."
# Or just paste the key into the API key cell at the top of each notebook.

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
